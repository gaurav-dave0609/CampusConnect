// Prisma Schema for Campus Connect - All-in-One College Ecosystem

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum Role {
  STUDENT
  FACULTY
  ADMIN
  PLACEMENT_OFFICER
  CLUB_COORDINATOR
}

enum SubjectType {
  THEORY
  LAB
  ELECTIVE
}

enum RoomType {
  CLASSROOM
  LAB
  AUDITORIUM
  SEMINAR_HALL
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum TimetableStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum SubmissionStatus {
  NOT_SUBMITTED
  SUBMITTED
  LATE
  GRADED
  RESUBMITTED
  EVALUATED
}

enum NoticeStatus {
  DRAFT
  PUBLISHED
  EXPIRED
  ARCHIVED
}

enum NoticePriority {
  NORMAL
  IMPORTANT
  URGENT
}

enum NoticeCategory {
  ACADEMIC
  EXAMINATION
  ATTENDANCE
  PLACEMENT
  EVENT
  CLUB
  HOLIDAY
  GENERAL
  URGENT
  ADMINISTRATIVE
}

enum NoticeAudience {
  ALL
  STUDENTS
  FACULTY
  STAFF
  ADMIN
  CLASS
  DIVISION
  DEPARTMENT
  SEMESTER
}

enum NotificationType {
  ASSIGNMENT
  ATTENDANCE
  TIMETABLE
  EVENT
  NOTICE
  PLACEMENT
  CLUB
  LOST_FOUND
  SYSTEM
  ACADEMIC
  PROFILE
  ADMIN
  EXAMINATION
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum PreferenceChannel {
  IN_APP
  EMAIL
  DISABLED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  COMPLETED
  ARCHIVED
}

enum EventCategory {
  WORKSHOP
  SEMINAR
  HACKATHON
  CULTURAL
  SPORTS
  CLUB
  PLACEMENT
  TECHNICAL
  COMPETITION
  WEBINAR
  OTHER
}

enum EventAttendanceStatus {
  UNMARKED
  PRESENT
  ABSENT
}

enum RegistrationStatus {
  REGISTERED
  CANCELLED
  ATTENDED
}

enum ClubStatus {
  DRAFT
  PUBLISHED
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum ClubCategory {
  TECHNICAL
  CULTURAL
  LITERARY
  SPORTS
  SOCIAL
  ENTREPRENEURSHIP
  DESIGN
  ROBOTICS
  CODING
  OTHER
}

enum MembershipRole {
  MEMBER
  COORDINATOR
  FACULTY_ADVISOR
  CORE_MEMBER
  LEAD
}

enum MembershipStatus {
  PENDING
  ACTIVE
  APPROVED
  REJECTED
  LEFT
}

enum ClubActivityType {
  MEETING
  WORKSHOP
  PRACTICE
  TRAINING
  COMPETITION_PREP
  COMMUNITY_SERVICE
  OTHER
}

enum PlacementDriveStatus {
  DRAFT
  PUBLISHED
  APPLICATION_CLOSED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum EmploymentType {
  FULL_TIME
  INTERNSHIP
  INTERNSHIP_TO_FULL_TIME
  CONTRACT
}

enum JobType {
  FULL_TIME
  INTERNSHIP
}

enum JobStatus {
  OPEN
  CLOSED
}

enum ApplicationStatus {
  APPLIED
  SHORTLISTED
  ASSESSMENT
  INTERVIEW
  INTERVIEW_SCHEDULED
  SELECTED
  OFFERED
  REJECTED
  WITHDRAWN
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum QuizStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

enum PrepCategory {
  QUANTITATIVE_APTITUDE
  LOGICAL_REASONING
  VERBAL_ABILITY
  DATA_INTERPRETATION
  TECHNICAL_MCQ
  PROGRAMMING
  DSA
  DBMS
  OPERATING_SYSTEMS
  NETWORKS
  OOP
  HR_INTERVIEW
  COMPANY_SPECIFIC
  RESUME_PREPARATION
  APTITUDE
  CODING
  TECHNICAL_INTERVIEW
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum LostFoundCategory {
  ELECTRONICS
  ID_DOCUMENT
  STUDENT_CARD
  BOOK
  BAG
  CLOTHING
  KEYS
  JEWELLERY
  ACCESSORY
  STATIONERY
  SPORTS
  WALLET
  WATER_BOTTLE
  OTHER
}

enum LostFoundStatus {
  DRAFT
  PUBLISHED
  CLAIM_PENDING
  VERIFICATION
  RESOLVED
  CLOSED
  EXPIRED
  ARCHIVED
  REJECTED
}

enum LostFoundType {
  LOST
  FOUND
}

enum ItemStatus {
  OPEN
  CLAIMED
  RESOLVED
}

enum ClaimStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  APPROVED
  REJECTED
  WITHDRAWN
  COMPLETED
}

enum ExamType {
  INTERNAL
  MIDTERM
  PRACTICAL
  VIVA
  END_SEMESTER
  OTHER
}

enum ExamStatus {
  DRAFT
  SCHEDULED
  ONGOING
  COMPLETED
  RESULTS_PENDING
  PUBLISHED
  LOCKED
  ARCHIVED
}

enum RevaluationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  COMPLETED
}

// -------------------------------------------------------------
// CORE AUTHENTICATION & USERS
// -------------------------------------------------------------

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  role         Role      @default(STUDENT)
  firstName    String
  lastName     String
  avatarUrl    String?
  phone        String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  studentProfile   Student?
  facultyProfile   Faculty?
  authoredNotices  Notice[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  reportedItems    LostFoundItem[]
  lostFoundClaims  LostFoundClaim[]
  gradesGiven      AssignmentGrade[] @relation("GradesGiven")
  noticesRead      NoticeRead[]
  organizedEvents  Event[]           @relation("OrganizedEvents")
  eventRegistrations EventRegistration[]
  advisedClubs     Club[]            @relation("FacultyAdvisorClubs")
  coordinatedClubs Club[]            @relation("CoordinatorClubs")
  clubMemberships  ClubMembership[]
  createdActivities ClubActivity[]   @relation("CreatedActivities")
  createdDrives    PlacementDrive[]  @relation("CreatedDrives")
  createdQuizzes   Quiz[]            @relation("CreatedQuizzes")
  statusChanges    ApplicationStatusHistory[] @relation("StatusChanges")
  notificationPreferences NotificationPreference[]

  @@index([email])
  @@index([role])
}

// -------------------------------------------------------------
// ACADEMIC STRUCTURE
// -------------------------------------------------------------

model Department {
  id               String       @id @default(uuid())
  name             String       @unique
  code             String       @unique
  description      String?
  headOfDepartment String?
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  classes          Class[]
  faculty          Faculty[]
  subjects         Subject[]
  students         Student[]
  notices          Notice[]
  clubs            Club[]
  programs         Program[]
  laboratories     Laboratory[]
  rooms            Room[]
  exams            Exam[]
}

model Program {
  id             String       @id @default(uuid())
  name           String
  code           String       @unique
  degree         String       // e.g. "B.Tech", "M.Tech", "BCA", "MCA"
  departmentId   String
  durationYears  Int          @default(4)
  totalSemesters Int          @default(8)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  department     Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  batches        Batch[]
  classes        Class[]
  subjects       Subject[]
  exams          Exam[]

  @@index([code])
  @@index([departmentId])
}

model Batch {
  id              String       @id @default(uuid())
  name            String       // e.g. "Batch 2022-2026"
  startYear       Int
  endYear         Int
  programId       String
  currentSemester Int          @default(1)
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  program         Program      @relation(fields: [programId], references: [id], onDelete: Cascade)
  classes         Class[]
  exams           Exam[]

  @@unique([programId, name])
  @@index([programId])
}

model AcademicSemester {
  id             String       @id @default(uuid())
  semesterNumber Int          // 1 to 8
  academicYear   String       // e.g. "2024-2025"
  term           String       @default("EVEN") // ODD, EVEN, FALL, SPRING
  startDate      DateTime?
  endDate        DateTime?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([semesterNumber, academicYear, term])
}

model Class {
  id           String      @id @default(uuid())
  departmentId String
  semester     Int
  name         String      // e.g. "TE Computer Eng"
  academicYear String      // e.g. "2024-2025"
  programId    String?
  batchId      String?
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  department   Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  program      Program?    @relation(fields: [programId], references: [id], onDelete: SetNull)
  batch        Batch?      @relation(fields: [batchId], references: [id], onDelete: SetNull)
  divisions    Division[]
  notices      Notice[]

  @@unique([departmentId, semester, academicYear])
}

model Division {
  id              String           @id @default(uuid())
  classId         String
  name            String           // e.g. "Division A"
  code            String?          // e.g. "CE-A"
  capacity        Int              @default(60)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  class           Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  students        Student[]
  facultySubjects FacultySubject[]
  timetables      Timetable[]
  attendances     Attendance[]
  notices         Notice[]
  exams           Exam[]

  @@unique([classId, name])
}

model Subject {
  id              String           @id @default(uuid())
  name            String
  code            String           @unique
  departmentId    String
  semester        Int
  credits         Int              @default(3)
  type            SubjectType      @default(THEORY)
  weeklyHours     Int              @default(3)
  description     String?
  syllabusUrl     String?
  programId       String?
  laboratoryId    String?
  requiresLab     Boolean          @default(false)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  department      Department       @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  program         Program?         @relation(fields: [programId], references: [id], onDelete: SetNull)
  laboratory      Laboratory?      @relation(fields: [laboratoryId], references: [id], onDelete: SetNull)
  facultySubjects FacultySubject[]
  timetableSlots  TimetableSlot[]
  exams           Exam[]
  revaluations    RevaluationRequest[]

  @@index([code])
}

model FacultySubject {
  id           String          @id @default(uuid())
  facultyId    String
  subjectId    String
  divisionId   String
  academicYear String
  weeklyHours  Int?
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  faculty        Faculty         @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  subject        Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  division       Division        @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  attendances    Attendance[]
  assignments    Assignment[]
  timetableSlots TimetableSlot[]

  @@unique([facultyId, subjectId, divisionId, academicYear])
}

model Room {
  id           String          @id @default(uuid())
  roomNumber   String          @unique
  building     String
  floor        Int
  capacity     Int
  type         RoomType        @default(CLASSROOM)
  hasProjector Boolean         @default(true)
  isAvailable  Boolean         @default(true)
  departmentId String?
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  department     Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  laboratories   Laboratory[]
  timetableSlots TimetableSlot[]
  events         Event[]
  exams          Exam[]

  @@index([roomNumber])
}

model Laboratory {
  id           String      @id @default(uuid())
  name         String
  code         String      @unique
  departmentId String
  roomId       String?
  capacity     Int         @default(30)
  equipment    String[]    @default([])
  labAssistant String?
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  department   Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  room         Room?       @relation(fields: [roomId], references: [id], onDelete: SetNull)
  subjects     Subject[]

  @@index([code])
  @@index([departmentId])
}

// -------------------------------------------------------------
// PROFILES
// -------------------------------------------------------------

model Student {
  id           String          @id @default(uuid())
  userId       String          @unique
  rollNumber   String          @unique
  prnNumber    String          @unique
  departmentId String
  divisionId   String
  semester     Int
  batchYear    String          // e.g. "2022-2026"
  cgpa         Float           @default(0.0)
  skills       String[]        @default([])
  bio          String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department      @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  division     Division        @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  
  attendanceRecords  AttendanceRecord[]
  submissions        AssignmentSubmission[]
  eventRegistrations EventRegistration[]
  clubMemberships    ClubMembership[]
  jobApplications    PlacementApplication[]
  quizAttempts       QuizAttempt[]
  examEnrollments    ExamEnrollment[]
  gradebookEntries   GradebookEntry[]
  examResults        ExamResult[]
  revaluations       RevaluationRequest[]

  @@index([rollNumber])
  @@index([prnNumber])
}

model Faculty {
  id             String           @id @default(uuid())
  userId         String           @unique
  employeeId     String           @unique
  departmentId   String
  designation    String           // e.g. "Associate Professor"
  qualification  String           // e.g. "Ph.D. in CS"
  specialization String           // e.g. "Distributed Systems"
  officeRoom     String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  department     Department       @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  facultySubjects FacultySubject[]
  clubsMentored  Club[]
  examsInvigilated Exam[]

  @@index([employeeId])
}

// -------------------------------------------------------------
// ATTENDANCE MANAGEMENT
// -------------------------------------------------------------

model Attendance {
  id               String             @id @default(uuid())
  facultySubjectId String
  divisionId       String
  date             DateTime           @db.Date
  periodNumber     Int
  topicCovered     String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  facultySubject   FacultySubject     @relation(fields: [facultySubjectId], references: [id], onDelete: Cascade)
  division         Division           @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  records          AttendanceRecord[]

  @@unique([facultySubjectId, divisionId, date, periodNumber])
  @@index([date])
}

model AttendanceRecord {
  id           String           @id @default(uuid())
  attendanceId String
  studentId    String
  status       AttendanceStatus @default(PRESENT)
  remarks      String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  attendance   Attendance       @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  student      Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([attendanceId, studentId])
  @@index([studentId, status])
}

// -------------------------------------------------------------
// TIMETABLE SYSTEM
// -------------------------------------------------------------

model Timetable {
  id           String          @id @default(uuid())
  divisionId   String
  academicYear String
  semester     Int
  status       TimetableStatus @default(DRAFT)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  division     Division        @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  slots        TimetableSlot[]

  @@unique([divisionId, academicYear, semester])
}

model TimetableSlot {
  id               String          @id @default(uuid())
  timetableId      String
  dayOfWeek        DayOfWeek
  periodNumber     Int
  startTime        String          // e.g. "09:00"
  endTime          String          // e.g. "10:00"
  subjectId        String
  facultySubjectId String
  roomId           String
  isLabSession     Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  timetable        Timetable       @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  subject          Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  facultySubject   FacultySubject  @relation(fields: [facultySubjectId], references: [id], onDelete: Cascade)
  room             Room            @relation(fields: [roomId], references: [id], onDelete: Restrict)

  @@unique([timetableId, dayOfWeek, periodNumber])
  @@index([roomId, dayOfWeek, periodNumber])
}

// -------------------------------------------------------------
// ASSIGNMENT MANAGEMENT
// -------------------------------------------------------------

model Assignment {
  id                  String                 @id @default(uuid())
  facultySubjectId    String
  title               String
  description         String
  instructions        String?
  maxMarks            Int                    @default(100)
  dueDate             DateTime
  publishDate         DateTime               @default(now())
  status              AssignmentStatus       @default(PUBLISHED)
  allowLateSubmission Boolean                @default(true)
  latePenalty         Float                  @default(10.0) // % deducted for late submissions
  maxFileSize         Int                    @default(10485760) // 10MB in bytes
  allowedFileTypes    String[]               @default(["pdf", "docx", "zip", "txt"])
  attachmentUrl       String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  facultySubject      FacultySubject         @relation(fields: [facultySubjectId], references: [id], onDelete: Cascade)
  submissions         AssignmentSubmission[]
  attachments         AssignmentAttachment[]

  @@index([dueDate])
  @@index([status])
}

model AssignmentAttachment {
  id           String     @id @default(uuid())
  assignmentId String
  fileName     String
  fileUrl      String
  fileType     String
  fileSize     Int
  uploadedAt   DateTime   @default(now())

  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
}

model AssignmentSubmission {
  id                 String             @id @default(uuid())
  assignmentId       String
  studentId          String
  submittedAt        DateTime           @default(now())
  fileUrl            String?
  fileName           String?
  fileSize           Int?
  fileType           String?
  submissionText     String?
  comments           String?
  marksObtained      Float?
  feedback           String?
  isLate             Boolean            @default(false)
  latePenaltyApplied Float              @default(0.0)
  version            Int                @default(1)
  status             SubmissionStatus   @default(SUBMITTED)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  assignment         Assignment         @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student            Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  grades             AssignmentGrade[]

  @@unique([assignmentId, studentId])
  @@index([studentId, status])
}

model AssignmentGrade {
  id           String               @id @default(uuid())
  submissionId String
  marks        Float
  feedback     String?
  gradedBy     String
  gradedAt     DateTime             @default(now())
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  submission   AssignmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  grader       User                 @relation("GradesGiven", fields: [gradedBy], references: [id], onDelete: Restrict)

  @@index([submissionId])
}

// -------------------------------------------------------------
// NOTICES & NOTIFICATIONS
// -------------------------------------------------------------

model Notice {
  id            String         @id @default(uuid())
  authorId      String
  title         String
  summary       String?
  content       String
  category      NoticeCategory @default(ACADEMIC)
  priority      NoticePriority @default(NORMAL)
  audience      NoticeAudience @default(ALL)
  status        NoticeStatus   @default(PUBLISHED)
  departmentId  String?
  classId       String?
  divisionId    String?
  semester      Int?
  publishDate   DateTime       @default(now())
  expiryDate    DateTime?
  attachmentUrl String?
  isPublished   Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  department    Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  class         Class?         @relation(fields: [classId], references: [id], onDelete: SetNull)
  division      Division?      @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  attachments   NoticeAttachment[]
  reads         NoticeRead[]

  @@index([priority, publishDate])
  @@index([status, publishDate])
  @@index([category])
  @@index([audience])
}

model NoticeAttachment {
  id         String   @id @default(uuid())
  noticeId   String
  fileName   String
  fileUrl    String
  fileType   String
  fileSize   Int
  uploadedAt DateTime @default(now())

  notice     Notice   @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  @@index([noticeId])
}

model NoticeRead {
  id        String   @id @default(uuid())
  noticeId  String
  userId    String
  readAt    DateTime @default(now())

  notice    Notice   @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([noticeId, userId])
  @@index([userId])
  @@index([noticeId])
}

model Notification {
  id           String               @id @default(uuid())
  userId       String
  title        String
  message      String
  type         NotificationType     @default(SYSTEM)
  priority     NotificationPriority @default(NORMAL)
  link         String?
  isRead       Boolean              @default(false)
  readAt       DateTime?
  sourceEntity String?
  sourceId     String?
  dedupKey     String?
  groupKey     String?
  metadata     String?
  createdAt    DateTime             @default(now())

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([userId, type])
  @@index([userId, priority])
  @@index([dedupKey])
}

model NotificationPreference {
  id        String            @id @default(uuid())
  userId    String
  category  NotificationType
  channel   PreferenceChannel @default(IN_APP)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@index([userId])
}

// -------------------------------------------------------------
// EVENTS & CLUBS
// -------------------------------------------------------------

model Event {
  id                   String              @id @default(uuid())
  slug                 String              @unique
  title                String
  summary              String?
  description          String
  category             EventCategory       @default(WORKSHOP)
  status               EventStatus         @default(PUBLISHED)
  organizerId          String
  venue                String
  roomId               String?
  eventDate            DateTime            @default(now())
  startDateTime        DateTime
  endDateTime          DateTime
  registrationOpenAt   DateTime            @default(now())
  registrationDeadline DateTime
  capacity             Int
  posterUrl            String?
  isPublished          Boolean             @default(true)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  organizer            User                @relation("OrganizedEvents", fields: [organizerId], references: [id], onDelete: Cascade)
  room                 Room?               @relation(fields: [roomId], references: [id], onDelete: SetNull)
  registrations        EventRegistration[]
  clubEvents           ClubEvent[]

  @@index([startDateTime])
  @@index([status])
  @@index([category])
}

model EventRegistration {
  id               String                @id @default(uuid())
  eventId          String
  userId           String
  studentId        String?
  confirmationCode String                @default("")
  registeredAt     DateTime              @default(now())
  status           RegistrationStatus    @default(REGISTERED)
  attendanceStatus EventAttendanceStatus @default(UNMARKED)
  attendedAt       DateTime?
  markedBy         String?
  cancelledAt      DateTime?

  event            Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  student          Student?              @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@unique([eventId, userId])
  @@index([userId])
  @@index([eventId, status])
}

model Club {
  id               String           @id @default(uuid())
  name             String           @unique
  slug             String           @unique
  category         ClubCategory     @default(TECHNICAL)
  status           ClubStatus       @default(ACTIVE)
  description      String
  shortDescription String?
  logoUrl          String?
  bannerUrl        String?
  contactEmail     String?
  contactPhone     String?
  departmentId     String?
  facultyAdvisorId String?
  coordinatorId    String?
  mentorId         String?
  establishedYear  Int              @default(2020)
  isRecruiting     Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  department       Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  facultyAdvisor   User?            @relation("FacultyAdvisorClubs", fields: [facultyAdvisorId], references: [id], onDelete: SetNull)
  coordinator      User?            @relation("CoordinatorClubs", fields: [coordinatorId], references: [id], onDelete: SetNull)
  mentor           Faculty?         @relation(fields: [mentorId], references: [id], onDelete: SetNull)
  memberships      ClubMembership[]
  events           ClubEvent[]
  activities       ClubActivity[]

  @@index([status])
  @@index([category])
}

model ClubMembership {
  id         String           @id @default(uuid())
  clubId     String
  userId     String
  studentId  String?
  role       MembershipRole   @default(MEMBER)
  status     MembershipStatus @default(PENDING)
  appliedAt  DateTime         @default(now())
  joinedAt   DateTime?
  approvedAt DateTime?
  approvedBy String?
  leftAt     DateTime?

  club       Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  student    Student?         @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@unique([clubId, userId])
  @@index([userId])
  @@index([clubId, status])
}

model ClubActivity {
  id           String           @id @default(uuid())
  clubId       String
  title        String
  description  String
  activityDate DateTime
  activityType ClubActivityType @default(MEETING)
  venue        String?
  createdBy    String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  club         Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  creator      User             @relation("CreatedActivities", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([clubId, activityDate])
}

model ClubEvent {
  id        String   @id @default(uuid())
  clubId    String
  eventId   String

  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([clubId, eventId])
}

// -------------------------------------------------------------
// PLACEMENT PREPARATION & JOBS
// -------------------------------------------------------------
// PLACEMENTS & CORPORATE RELATIONS
// -------------------------------------------------------------

model PlacementCompany {
  id            String           @id @default(uuid())
  name          String           @unique
  slug          String           @unique
  website       String?
  industry      String
  logoUrl       String?
  description   String?
  location      String?
  companySize   String?          // e.g. "500-1000", "10000+"
  contactPerson String?
  contactEmail  String?
  contactPhone  String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  drives        PlacementDrive[]
  opportunities JobOpportunity[]
}

model PlacementDrive {
  id                  String                 @id @default(uuid())
  companyId           String
  title               String
  slug                String                 @unique
  role                String
  employmentType      EmploymentType         @default(FULL_TIME)
  location            String
  packageMin          Float
  packageMax          Float
  currency            String                 @default("INR")
  description         String
  applicationDeadline DateTime
  driveDate           DateTime?
  status              PlacementDriveStatus   @default(DRAFT)
  minCgpa             Float                  @default(6.0)
  maxBacklogs         Int                    @default(0)
  allowedDepartments String[]               @default([])
  allowedSemesters    Int[]                  @default([])
  requiredSkills      String[]               @default([])
  batchCriteria       String?
  bondDetails         String?
  selectionRounds     String[]               @default([])
  createdBy           String
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  company             PlacementCompany       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  creator             User                   @relation("CreatedDrives", fields: [createdBy], references: [id], onDelete: Restrict)
  applications        PlacementApplication[]

  @@index([status, applicationDeadline])
  @@index([companyId])
}

model JobOpportunity {
  id                  String                 @id @default(uuid())
  companyId           String
  title               String
  roleType            JobType                @default(FULL_TIME)
  packageLPA          Float
  stipendMonthly      Float?
  eligibilityCgpa     Float                  @default(6.0)
  eligibleDepartments String[]               @default([])
  deadline            DateTime
  driveDate           DateTime?
  location            String
  description         String
  status              JobStatus              @default(OPEN)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  company             PlacementCompany       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applications        PlacementApplication[]

  @@index([status, deadline])
}

model PlacementApplication {
  id                String                     @id @default(uuid())
  driveId           String?
  opportunityId     String?
  studentId         String
  resumeUrl         String?
  studentCgpa       Float?
  studentDepartment String?
  status            ApplicationStatus          @default(APPLIED)
  remarks           String?
  appliedAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  drive             PlacementDrive?            @relation(fields: [driveId], references: [id], onDelete: Cascade)
  opportunity       JobOpportunity?            @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  student           Student                    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  statusHistory     ApplicationStatusHistory[]

  @@unique([driveId, studentId])
  @@index([status])
}

model ApplicationStatusHistory {
  id            String               @id @default(uuid())
  applicationId String
  oldStatus     ApplicationStatus?
  newStatus     ApplicationStatus
  changedBy     String
  remarks       String?
  createdAt     DateTime             @default(now())

  application   PlacementApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  changer       User                 @relation("StatusChanges", fields: [changedBy], references: [id], onDelete: Restrict)

  @@index([applicationId])
}

// -------------------------------------------------------------
// PREPARATION & TIMED QUIZ ENGINE
// -------------------------------------------------------------

model PrepQuestion {
  id                 String             @id @default(uuid())
  category           PrepCategory
  question           String
  options            String[]
  correctOptionIndex Int
  explanation        String?
  difficulty         QuestionDifficulty @default(MEDIUM)
  topic              String
  marks              Int                @default(1)
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  quizQuestions      QuizQuestion[]
  attemptAnswers     QuizAttemptAnswer[]

  @@index([category, difficulty])
}

model PreparationResource {
  id          String       @id @default(uuid())
  title       String
  category    PrepCategory
  content     String
  resourceUrl String?
  difficulty  Difficulty   @default(MEDIUM)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([category])
}

model Quiz {
  id              String         @id @default(uuid())
  title           String
  slug            String         @unique
  category        PrepCategory
  durationSeconds Int            @default(1800) // 30 mins
  questionCount   Int            @default(10)
  totalMarks      Int            @default(20)
  passingMarks    Int            @default(10)
  status          QuizStatus     @default(DRAFT)
  createdBy       String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  creator         User           @relation("CreatedQuizzes", fields: [createdBy], references: [id], onDelete: Restrict)
  quizQuestions   QuizQuestion[]
  questions       Question[]
  attempts        QuizAttempt[]

  @@index([status, category])
}

model QuizQuestion {
  id         String       @id @default(uuid())
  quizId     String
  questionId String
  order      Int          @default(0)

  quiz       Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  question   PrepQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([quizId, questionId])
  @@index([quizId])
}

model Question {
  id                 String   @id @default(uuid())
  quizId             String
  questionText       String
  options            String[] // 4 options
  correctOptionIndex Int      // 0-3
  explanation        String?
  marks              Int      @default(2)

  quiz               Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model QuizAttempt {
  id               String              @id @default(uuid())
  quizId           String
  studentId        String
  status           AttemptStatus       @default(IN_PROGRESS)
  startedAt        DateTime            @default(now())
  expiresAt        DateTime
  submittedAt      DateTime?
  score            Float               @default(0.0)
  percentage       Float               @default(0.0)
  passed           Boolean             @default(false)
  totalCorrect     Int                 @default(0)
  totalIncorrect   Int                 @default(0)
  totalUnanswered  Int                 @default(0)
  timeTakenSeconds Int                 @default(0)
  answers          Json?               // Student selections map
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  quiz             Quiz                @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student          Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  attemptAnswers   QuizAttemptAnswer[]

  @@index([studentId, quizId])
  @@index([status])
}

model QuizAttemptAnswer {
  id                  String       @id @default(uuid())
  attemptId           String
  questionId          String
  selectedOptionIndex Int?
  isCorrect           Boolean      @default(false)
  marksAwarded        Float        @default(0.0)

  attempt             QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question            PrepQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
}

// -------------------------------------------------------------
// LOST & FOUND
// -------------------------------------------------------------

model LostFoundItem {
  id                  String                @id @default(uuid())
  referenceNumber     String                @unique
  reporterId          String
  type                LostFoundType
  title               String
  description         String
  category            LostFoundCategory
  status              LostFoundStatus       @default(PUBLISHED)
  location            String
  dateLostFound       DateTime              @db.Date
  timeLostFound       String?
  imageUrl            String?
  contactPreference   String                @default("CAMPUS_PORTAL")
  identifyingDetails  String?
  resolvedAt          DateTime?
  resolvedBy          String?
  resolutionNotes     String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  reporter            User                  @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  claims              LostFoundClaim[]
  attachments         LostFoundAttachment[]
  lostMatches         LostFoundMatch[]      @relation("LostItemMatches")
  foundMatches        LostFoundMatch[]      @relation("FoundItemMatches")

  @@index([type, status])
  @@index([category])
  @@index([reporterId])
}

model LostFoundClaim {
  id                  String         @id @default(uuid())
  itemId              String
  claimantId          String
  claimStatement      String
  verificationAnswers String
  status              ClaimStatus    @default(PENDING)
  submittedAt         DateTime       @default(now())
  reviewedAt          DateTime?
  reviewedBy          String?
  reviewerRemarks     String?
  resolvedAt          DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  item                LostFoundItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  claimant            User           @relation(fields: [claimantId], references: [id], onDelete: Cascade)

  @@unique([itemId, claimantId])
  @@index([status])
}

model LostFoundAttachment {
  id        String        @id @default(uuid())
  itemId    String
  fileUrl   String
  fileName  String
  fileSize  Int
  mimeType  String
  createdAt DateTime      @default(now())

  item      LostFoundItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
}

model LostFoundMatch {
  id              String        @id @default(uuid())
  lostItemId      String
  foundItemId     String
  matchScore      Int
  matchingFactors String
  status          String        @default("SUGGESTED")
  createdAt       DateTime      @default(now())
  reviewedAt      DateTime?

  lostItem        LostFoundItem @relation("LostItemMatches", fields: [lostItemId], references: [id], onDelete: Cascade)
  foundItem       LostFoundItem @relation("FoundItemMatches", fields: [foundItemId], references: [id], onDelete: Cascade)

  @@unique([lostItemId, foundItemId])
  @@index([lostItemId])
  @@index([foundItemId])
}

// -------------------------------------------------------------
// AUDIT LOGGING & SYSTEM SETTINGS
// -------------------------------------------------------------

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  action      String   // e.g. "CREATE_USER", "UPDATE_ATTENDANCE", "PUBLISH_TIMETABLE"
  entity      String   // e.g. "Attendance", "User", "Timetable"
  entityId    String?
  details     Json?
  ipAddress   String?
  userAgent   String?
  timestamp   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action, timestamp])
  @@index([userId])
}

model SystemSetting {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

// -------------------------------------------------------------
// EXAMINATION & RESULTS
// -------------------------------------------------------------

model Exam {
  id              String           @id @default(uuid())
  title           String
  examType        ExamType         @default(INTERNAL)
  academicYear    String           // e.g. "2024-2025"
  semesterNumber  Int
  departmentId    String
  programId       String?
  batchId         String?
  divisionId      String?
  subjectId       String
  date            DateTime         @db.Date
  startTime       String           // e.g. "10:00"
  endTime         String           // e.g. "13:00"
  roomId          String?
  facultyId       String?          // Assigned invigilator
  maxMarks        Float            @default(100)
  passingMarks    Float            @default(40)
  instructions    String?
  status          ExamStatus       @default(DRAFT)
  createdBy       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  department      Department       @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  program         Program?         @relation(fields: [programId], references: [id], onDelete: SetNull)
  batch           Batch?           @relation(fields: [batchId], references: [id], onDelete: SetNull)
  division        Division?        @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  subject         Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  room            Room?            @relation(fields: [roomId], references: [id], onDelete: SetNull)
  faculty         Faculty?         @relation(fields: [facultyId], references: [id], onDelete: SetNull)

  enrollments      ExamEnrollment[]
  gradebookEntries GradebookEntry[]
  revaluations     RevaluationRequest[]

  @@index([subjectId])
  @@index([departmentId, semesterNumber])
  @@index([date, status])
}

model ExamEnrollment {
  id                  String    @id @default(uuid())
  examId              String
  studentId           String
  isEligible          Boolean   @default(true)
  ineligibilityReason String?
  hallTicketNumber    String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  exam                Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  student             Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId])
  @@index([studentId])
}

model GradebookEntry {
  id            String    @id @default(uuid())
  examId        String
  studentId     String
  marksObtained Float?
  isAbsent      Boolean   @default(false)
  gradeLetter   String?   // "A+", "A", "B+", "B", "C", "D", "F"
  gradePoint    Float?    // 10.0, 9.0, 8.0, 7.0, 6.0, 5.0, 0.0
  isPassed      Boolean   @default(false)
  remarks       String?
  gradedBy      String?
  gradedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  exam          Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  student       Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId])
  @@index([studentId])
}

model ExamResult {
  id                    String    @id @default(uuid())
  studentId             String
  academicYear          String
  semesterNumber        Int
  gpa                   Float     @default(0.0)
  totalCreditsAttempted Int       @default(0)
  totalCreditsEarned    Int       @default(0)
  status                String    @default("PUBLISHED") // PUBLISHED, LOCKED
  publishedAt           DateTime  @default(now())
  publishedBy           String?
  lockedAt              DateTime?
  lockedBy              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  student               Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, academicYear, semesterNumber])
  @@index([studentId])
}

model RevaluationRequest {
  id              String            @id @default(uuid())
  examId          String
  studentId       String
  subjectId       String
  reason          String
  currentMarks    Float
  requestedMarks  Float?
  reviewedMarks   Float?
  status          RevaluationStatus @default(PENDING)
  reviewerRemarks String?
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  exam            Exam              @relation(fields: [examId], references: [id], onDelete: Cascade)
  student         Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject         Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([examId])
  @@index([status])
}
